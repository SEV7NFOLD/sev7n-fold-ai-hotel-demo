{
  "name": "ava-phone-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-agnostic telephony bridge between phone providers and the Gemini Live API, powering real phone calls to Ava.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx test/run.ts"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
