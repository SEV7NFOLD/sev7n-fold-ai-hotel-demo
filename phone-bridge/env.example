# ---------------------------------------------------------------------------
# Ava Phone Bridge — example environment
#
# Copy to .env.local for local development:
#     cp env.example .env.local
#
# NEVER commit .env.local or any real credential.
# This file contains placeholders only.
# ---------------------------------------------------------------------------

# --- Gemini Live (required) -------------------------------------------------
# Server-side only. This value never reaches a browser or a phone provider.
GEMINI_API_KEY=

# Gemini Live model. Default: gemini-3.8-live
GEMINI_LIVE_MODEL=gemini-3.8-live

# Prebuilt Gemini voice. Default: Kore
GEMINI_VOICE=Kore

# BCP-47 language for the speech config. Default: en-US
GEMINI_LANGUAGE_CODE=en-US

# --- Server -----------------------------------------------------------------
# Port the bridge listens on. Render injects this automatically.
PORT=8080

# Public HTTPS base URL of this service, with no trailing slash.
# REQUIRED on Render and in production: it is used to build the wss:// media-stream URL
# that the phone provider must connect back to, and to canonicalise the Twilio signature.
# Example: https://ava-phone-bridge.onrender.com
PUBLIC_BASE_URL=

# Optional override if media streams should terminate somewhere other than PUBLIC_BASE_URL,
# e.g. when a proxy rewrites the host. Accepts https:// or wss://.
PUBLIC_WS_URL=

# --- Ava personality (all optional; defaults live in src/ava/prompt.ts) -----
# Business name injected into the prompt.
AVA_BUSINESS_NAME=SEV7N FOLD

# Path to a file containing the full system prompt. Takes precedence over AVA_SYSTEM_PROMPT.
# Relative paths resolve from the phone-bridge package root.
AVA_SYSTEM_PROMPT_FILE=

# Inline system prompt override (used when AVA_SYSTEM_PROMPT_FILE is unset).
AVA_SYSTEM_PROMPT=

# Optional reference catalogue. Plain text, or JSON array of { category, title, content }.
AVA_KNOWLEDGE_FILE=

# Opening line Ava speaks once Gemini is ready. Empty string disables the greeting.
AVA_GREETING=

# Seconds of caller silence before Ava gently checks in. 0 disables.
AVA_IDLE_PROMPT_SECONDS=0

# --- Twilio (optional for local development) --------------------------------
# Your Twilio Account Auth Token. When set, POST /twilio/voice validates the
# X-Twilio-Signature header. When unset, validation is skipped and logged as such.
TWILIO_AUTH_TOKEN=

# --- Security ---------------------------------------------------------------
# Optional shared secret appended to the media WebSocket URL as ?token=...
# Set this in production so a random client cannot open a media socket and burn
# Gemini quota. Leave empty for local testing.
AVA_MEDIA_TOKEN=

# Comma-separated Origin allow-list for the media WebSocket. Empty = allow all
# (telephony providers send no Origin header, so this is mainly for browser tests).
AVA_ALLOWED_ORIGINS=

# Honour x-forwarded-proto / x-forwarded-host from a reverse proxy. Default: true
AVA_TRUST_PROXY=true

# --- Limits -----------------------------------------------------------------
# Maximum simultaneous calls.
AVA_MAX_CONCURRENT_CALLS=20

# Hard wall-clock limit per call, seconds. 0 disables. Default: 1800
AVA_MAX_CALL_SECONDS=1800

# Milliseconds of caller audio batched before sending to Gemini. Default: 100
AVA_SEND_CHUNK_MS=100

# --- Logging ----------------------------------------------------------------
# debug | info | warn | error
AVA_BRIDGE_LOG_LEVEL=info

# json (default, for Render) | pretty (human-readable locally)
AVA_BRIDGE_LOG_FORMAT=pretty

# Set true ONLY for local debugging. Logs full caller numbers.
# Never enable in production.
AVA_BRIDGE_LOG_PII=false
